/*
=========================================================
ASIENTO DESIGN SYSTEM
=========================================================

BACKGROUND APP      #1E1E1E
BACKGROUND CARD     #2A2A2A

PRIMARY             #2563EB
SUCCESS             #22C55E
WARNING             #F59E0B
ERROR               #EF4444

TEXT                #FFFFFF
TEXT SECONDARY      #CFCFCF

BORDER              #404040

RADIUS              8px
PADDING             12px
=========================================================
*/




/* =========================================================
   APPLICATION
   ========================================================= */

/* QMainWindow {
    background-color: #1E1E1E;
}
QWidget {
    background-color: #1E1E1E;
    color: #FFFFFF;
} */


/* =========================================================
   BUTTONS (BASE)
   ========================================================= */

QPushButton {

    color: white;

    border: none;
    border-radius: 8px;

    padding: 6px 12px;

    font-size: 14px;
    font-weight: 600;

    min-height: 32px;
}

/*QPushButton:hover {

    background-color: #1D4ED8;
}

QPushButton:pressed {

    background-color: #1E40AF;
}

QPushButton:disabled {

    background-color: #505050;
    color: #B0B0B0;
}
/*

/* =========================================================
   SELECT BUTTON
   ========================================================= */

QPushButton#selectButton {

    background-color: #404040;
}

QPushButton#selectButton:hover {

    background-color: #505050;
}

QPushButton#selectButton:pressed {

    background-color: #606060;
}

/* =========================================================
   PROCESS BUTTON
   ========================================================= */

QPushButton#processButton {

    background-color: #2563EB;
}

QPushButton#processButton:hover {

    background-color: #1D4ED8;
}

QPushButton#processButton:pressed {

    background-color: #1E40AF;
}

/* =========================================================
   REVIEW BUTTON
   ========================================================= */

QPushButton#reviewButton {
    background-color: #3F4A5A;
    color: white;
}

QPushButton#reviewButton:hover {
    background-color: #4B586A;
}

QPushButton#reviewButton:pressed {
    background-color: #36404F;
}

QPushButton#reviewButton:disabled {
    background-color: #353535;
    color: #777777;
}

/* =========================================================
   EXPORT BUTTON
   ========================================================= */

QPushButton#exportButton {

    background-color: #22C55E;
    color: white;
}

QPushButton#exportButton:hover {

    background-color: #16A34A;
}

QPushButton#exportButton:pressed {

    background-color: #15803D;
}

QPushButton#exportButton:disabled {

    background-color: #353535;
    color: #777777;
}

/* =========================================================
   FILE CARD
   ========================================================= */

QWidget#fileCard {

    background-color: #2A2A2A;

    border: 1px solid #404040;
    border-radius: 10px;
    
   
}
QLabel {

    background: transparent;
}

QLabel#fileName {

    font-size: 16px;
    font-weight: bold;

    color: white;
}

QLabel#bankLabel {

    font-size: 13px;

    color: #CFCFCF;
}

QLabel#statusLabel {

    font-size: 13px;

    color: #22C55E;
}

/* =========================================================
   METRIC CARD
   ========================================================= */

QWidget#metricCard {

    background-color: #2A2A2A;

    border: 1px solid #404040;
    border-radius: 10px;
}

QLabel#metricTitle {

    background: transparent;

    color: #CFCFCF;

    font-size: 13px;
}

QLabel#metricValue {

    background: transparent;

    color: white;

    font-size: 28px;

    font-weight: bold;
}

/* =========================================================
   LOG PANEL
   ========================================================= */

QWidget#logPanel {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 10px;
}

QTextEdit#logText {

    background-color: transparent;

    border: none;

    color: #CFCFCF;

    font-family: Consolas;
    font-size: 13px;

    selection-background-color: #2563EB;
}

QScrollBar:vertical {

    background: transparent;

    width: 10px;

    margin: 0px;
}

QScrollBar::handle:vertical {

    background: #505050;

    border-radius: 5px;

    min-height: 25px;
}

QScrollBar::handle:vertical:hover {

    background: #707070;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {

    background: transparent;
}


/* =========================================================
   ACTION BAR
   ========================================================= */

QWidget#actionBar {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 10px;
}
/* =========================================================
   TABLES
   ========================================================= */

QTableWidget {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    gridline-color: #404040;

    color: white;

    selection-background-color: #2563EB;

    selection-color: white;

    alternate-background-color: #323232;

    font-size: 13px;

}

QHeaderView::section {

    background-color: #252525;

    color: white;

    border: none;

    border-bottom: 1px solid #404040;

    padding: 8px;

    font-weight: bold;

}

QTableCornerButton::section {

    background-color: #252525;

    border: none;

}

QTableWidget::item {

    padding: 6px;

}

QTableWidget::item:selected {

    background-color: #2563EB;

    color: white;

}

/* =========================================================
   HISTORY VIEW
   ========================================================= */

QWidget#historyView {
    background-color: #1E1E1E;
}

QLabel#historyTitle {
    background: transparent;

    color: #FFFFFF;

    font-size: 26px;
    font-weight: 700;
}

QLabel#historySubtitle {
    background: transparent;

    color: #AFAFAF;

    font-size: 13px;
}
QPushButton#backHistoryButton{

    background-color: #3F4A5A;
    color: white;
}

QPushButton#backHistoryButton:hover {

    background-color: #4B586A;
}

QPushButton#backHistoryButton:pressed {

    background-color: #36404F;
}

QPushButton#saveHistoryButton{

    background-color: #2563EB;
    color: white;
}

QPushButton#saveHistoryButton:hover {

    background-color: #1D4ED8;
}

QPushButton#saveHistoryButton:pressed {

    background-color: #1E40AF;
}

QPushButton#resetHistoryButton{
    background-color: #3F4A5A;
    color: white;
    
}

QPushButton#processButton:hover {
    background-color: #4B586A;
    
}

QPushButton#processButton:pressed {
    background-color: #36404F;
    
}

QPushButton#pdfHistoryButton{
    background-color: #ebc725;
    color: white;
}

QPushButton#pdfHistoryButton:hover {

    background-color: #ebc725f1;
}

QPushButton#backHistoryButton:pressed {
    background-color: #ebc725c2;
    
}


/* =========================================================
   HISTORY TABLE
   ========================================================= */

QTableWidget#historyTable {

    border-radius: 10px;

}

/* =========================================================
   REVIEW TABLE
   ========================================================= */

QTableWidget#reviewTable {

    border-radius: 10px;

}

/* =========================================================
   SIDEBAR
   ========================================================= */

QWidget#sidebar {
    background-image: url("app/resources/icons/background.png");
    background-repeat: no-repeat;
    background-position: center;
    background-origin: content;
    background-color: #1E1E1E;
    border-right: 1px solid #303030;
}



/* =========================================================
   SIDEBAR BUTTONS
   ========================================================= */

QPushButton#sidebarButton {

    background: transparent;

    border: none;

    border-left: 3px solid transparent;

    border-radius: 8px;

    color: #D8D8D8;

    text-align: left;

    padding-top: 10px;
    padding-bottom: 10px;

    font-size: 14px;

    font-weight: 700;

}

QPushButton#sidebarButton:disabled {
    opacity: 0.45;
    color: #777777;
    cursor: default;
}

/* =========================================================
   SIDEBAR BRAND
   ========================================================= */

QLabel#sidebarTitle {

    font-size: 30px;
    font-weight: 800;
    color: white;
    letter-spacing: 2px;

    margin: 0px;
    padding: 0px;
}

QLabel#sidebarSubtitle {

    font-size: 12px;
    font-weight: 500;
    color: #8F8F8F;

    margin: 0px;
    margin-top: -4px;
    padding: 0px;
}

QFrame#sidebarSeparator {

    background-color: #343434;

    max-height: 1px;

    min-height: 1px;

    border: none;

}

QLabel#sidebarVersion {

    color: #6E6E6E;

    font-size: 11px;

    font-weight: 500;

    padding-bottom: 6px;

}

/* =========================================================
   MAIN CONTENT
   ========================================================= */


/* =========================================================
   EXPORT VIEW
   ========================================================= */

QWidget#exportView {
    background-color: #1E1E1E;
}

/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

QLabel#exportTitle {
    background: transparent;

    color: #FFFFFF;

    font-size: 26px;
    font-weight: 700;
}

QLabel#exportSubtitle {
    background: transparent;

    color: #AFAFAF;

    font-size: 13px;
}

/* ---------------------------------------------------------
   EXPORT CARD
   --------------------------------------------------------- */

QWidget#exportCard {
    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 12px;
}

/* ---------------------------------------------------------
   FIELD LABELS
   --------------------------------------------------------- */

QLabel#exportFieldLabel {
    background: transparent;

    color: #CFCFCF;

    font-size: 13px;
    font-weight: 600;
}

/* ---------------------------------------------------------
   COMBO BOX
   --------------------------------------------------------- */

QComboBox#exportCombo {
    background-color: #242424;

    color: #FFFFFF;

    border: 1px solid #454545;

    border-radius: 7px;

    padding: 8px 12px;

    min-height: 34px;
}

QComboBox#exportCombo:hover {
    border: 1px solid #5A5A5A;
}

QComboBox#exportCombo:focus {
    border: 1px solid #2563EB;
}

QComboBox#exportCombo QAbstractItemView {
    background-color: #2A2A2A;

    color: #FFFFFF;

    border: 1px solid #404040;

    selection-background-color: #2563EB;

    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------
   FILE NAME
   --------------------------------------------------------- */

QLineEdit#exportFileName {
    background-color: #242424;

    color: #FFFFFF;

    border: 1px solid #454545;

    border-radius: 7px;

    padding: 8px 12px;

    min-height: 34px;
}

QLineEdit#exportFileName:hover {
    border: 1px solid #5A5A5A;
}

QLineEdit#exportFileName:focus {
    border: 1px solid #2563EB;
}

/* ---------------------------------------------------------
   EDIT TEMPLATE
   --------------------------------------------------------- */

QPushButton#editTemplateButton {
    background-color: #404040;

    color: #FFFFFF;

    border-radius: 7px;

    padding: 8px 14px;

    min-height: 32px;
}

QPushButton#editTemplateButton:hover {
    background-color: #4A4A4A;
}

QPushButton#editTemplateButton:pressed {
    background-color: #353535;
}

/* ---------------------------------------------------------
   EXPORT
   --------------------------------------------------------- */

QPushButton#exportButton {
    background-color: #22C55E;

    color: #FFFFFF;
}

QPushButton#exportButton:hover {
    background-color: #16A34A;
}

QPushButton#exportButton:pressed {
    background-color: #15803D;
}

QComboBox#exportCombo {
    background-color: #242424;
    color: #FFFFFF;

    border: 1px solid #454545;
    border-radius: 7px;

    padding: 6px 12px;
    min-height: 34px;

    font-size: 13px;
    font-weight: 500;

    /* flecha personalizada */
    qproperty-iconSize: 14px;
}

QComboBox#exportCombo:hover {
    border: 1px solid #5A5A5A;
    background-color: #2C2C2C;
}

QComboBox#exportCombo:focus {
    border: 1px solid #2563EB;
    background-color: #2F2F2F;
}
QComboBox#exportCombo QAbstractItemView {
    background-color: #2A2A2A;
    color: #FFFFFF;

    border: 1px solid #404040;
    border-radius: 6px;

    selection-background-color: #2563EB;
    selection-color: #FFFFFF;

    font-size: 13px;
}

/* ---------------------------------------------------------
   CANCEL
   --------------------------------------------------------- */

QPushButton#cancelExportButton {
    background-color: #404040;

    color: #D8D8D8;
}

QPushButton#cancelExportButton:hover {
    background-color: #4A4A4A;
}

QPushButton#cancelExportButton:pressed {
    background-color: #353535;
}

/* =========================================================
   TEMPLATE EDITOR (Dark Theme)
   ========================================================= */

QWidget#templateEditorView {
    background-color: #1E1E1E;
    color: #FFFFFF;
}

/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */
QLabel#templateEditorTitle {
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel#templateEditorSubtitle {
    font-size: 13px;
    color: #CFCFCF;
}

/* ---------------------------------------------------------
   CARD
   --------------------------------------------------------- */
QWidget#templateEditorCard {
    background-color: #2A2A2A;
    border: 1px solid #404040;
    border-radius: 10px;
    padding: 20px;
}

/* ---------------------------------------------------------
   FIELD LABELS
   --------------------------------------------------------- */
QLabel#templateFieldLabel {
    font-size: 13px;
    font-weight: 600;
    color: #CFCFCF;
    margin-bottom: 4px;
}

/* ---------------------------------------------------------
   INPUTS
   --------------------------------------------------------- */
QLineEdit#templateNameInput {
    background-color: #242424;
    color: #FFFFFF;
    border: 1px solid #454545;
    border-radius: 7px;
    padding: 8px 12px;
}

QLineEdit#templateNameInput:hover {
    border: 1px solid #5A5A5A;
}

QLineEdit#templateNameInput:focus {
    border: 1px solid #2563EB;
}

/* ---------------------------------------------------------
   COLUMN LIST
   --------------------------------------------------------- */
QListWidget#templateColumnsList {
    background-color: #2A2A2A;
    border: 1px solid #404040;
    border-radius: 7px;
    padding: 6px;

   
}

QListWidget#templateColumnsList::item {
    min-height: 40px;
    padding: 0 8px;
    color: #FFFFFF;
}

QListWidget#templateColumnsList::item:selected {
    background-color: transparent;
}

QListWidget#templateColumnsList::item:hover {
    background-color: #333333;
}

/* ---------------------------------------------------------
   TEMPLATE COLUMN WIDGET
   --------------------------------------------------------- */
QWidget#templateColumnWidget {
    background-color: #2A2A2A;
    border: 1px solid #404040;
    color : #FFFFFF;
    border-radius: 6px;
    padding: 6px;
}

QPushButton#removeColumnButton {
    background-color: #404040;
    color: #FFFFFF;
    border-radius: 10px;
    font-weight: bold;
    min-width: 15px;
    min-height: 15px;
}

QPushButton#removeColumnButton:hover {
    background-color: #505050;
}

/* ---------------------------------------------------------
   ADD COLUMN BUTTON
   --------------------------------------------------------- */
QPushButton#addTemplateColumnButton {
    background-color: #404040;
    color: #CFCFCF;
    border: 1px dashed #505050;
    border-radius: 6px;
    padding: 10px 12px;
    margin-top: 10px;
}

QPushButton#addTemplateColumnButton:hover {
    background-color: #505050;
    border-color: #606060;
}

/* ---------------------------------------------------------
   ACTION BUTTONS
   --------------------------------------------------------- */
QPushButton#cancelTemplateButton {
    background-color: #404040;
    color: #D8D8D8;
    border-radius: 6px;
    padding: 8px 18px;
}

QPushButton#cancelTemplateButton:hover {
    background-color: #4A4A4A;
}

QPushButton#saveTemplateButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border-radius: 6px;
    padding: 8px 20px;
    font-weight: 600;
}

QPushButton#saveTemplateButton:hover {
    background-color: #1D4ED8;
}

QPushButton#deleteTemplateButton {
    background-color: transparent;
    border: none;
    padding: 1px;
}



/* MAIN CON FONDO*/

QWidget#mainContent {
    background-color: rgba(30, 30, 30, 220); /* gris translúcido */
}

QWidget#converterView,
QWidget#reviewView,
QWidget#historyView,
QWidget#settingsView,
QWidget#exportView,
QWidget#templateEditorView {
    background-color: rgba(42, 42, 42, 180); /* más transparente */
    border-radius: 10px;
}


QWidget#fileCard,
QWidget#actionBar,
QWidget#summaryPanel,
QWidget#logPanel,
QWidget#pdfViewer,
QWidget#rightPanel {
    background-color: rgba(42, 42, 42, 180); /* gris translúcido */
    border-radius: 8px;
}

QLabel#conversionTitle {
    font-size: 26px;
    font-weight: 700;
    color: #FFFFFF;
}

QLabel#conversionSubtitle {
    font-size: 13px;
    color: #CFCFCF;
}


