/*
=========================================================
ASIENTO DESIGN SYSTEM
=========================================================

BACKGROUND APP      #1E1E1E
BACKGROUND CARD     #2A2A2A

PRIMARY             #2563EB
SUCCESS             #22C55E
WARNING             #F59E0B
ERROR               #EF4444

TEXT                #FFFFFF
TEXT SECONDARY      #CFCFCF

BORDER              #404040

RADIUS              8px
PADDING             12px
=========================================================
*/




/* =========================================================
   APPLICATION
   ========================================================= */

QMainWindow {

    background-color: #1E1E1E;
}
QWidget {

    background-color: #1E1E1E;
    color: #FFFFFF;
}

/* =========================================================
   BUTTONS (BASE)
   ========================================================= */

QPushButton {

    color: white;

    border: none;
    border-radius: 8px;

    padding: 8px 16px;

    font-size: 14px;
    font-weight: 600;

    min-height: 34px;
}

/*QPushButton:hover {

    background-color: #1D4ED8;
}

QPushButton:pressed {

    background-color: #1E40AF;
}

QPushButton:disabled {

    background-color: #505050;
    color: #B0B0B0;
}
/*

/* =========================================================
   SELECT BUTTON
   ========================================================= */

QPushButton#selectButton {

    background-color: #404040;
}

QPushButton#selectButton:hover {

    background-color: #505050;
}

QPushButton#selectButton:pressed {

    background-color: #606060;
}

/* =========================================================
   PROCESS BUTTON
   ========================================================= */

QPushButton#processButton {

    background-color: #2563EB;
}

QPushButton#processButton:hover {

    background-color: #1D4ED8;
}

QPushButton#processButton:pressed {

    background-color: #1E40AF;
}

/* =========================================================
   REVIEW BUTTON
   ========================================================= */

QPushButton#reviewButton {
    background-color: #3F4A5A;
    color: white;
}

QPushButton#reviewButton:hover {
    background-color: #4B586A;
}

QPushButton#reviewButton:pressed {
    background-color: #36404F;
}

QPushButton#reviewButton:disabled {
    background-color: #353535;
    color: #777777;
}

/* =========================================================
   EXPORT BUTTON
   ========================================================= */

QPushButton#exportButton {

    background-color: #22C55E;
    color: white;
}

QPushButton#exportButton:hover {

    background-color: #16A34A;
}

QPushButton#exportButton:pressed {

    background-color: #15803D;
}

QPushButton#exportButton:disabled {

    background-color: #353535;
    color: #777777;
}

/* =========================================================
   FILE CARD
   ========================================================= */

QWidget#fileCard {

    background-color: #2A2A2A;

    border: 1px solid #404040;
    border-radius: 10px;

    padding: 12px;
}
QLabel {

    background: transparent;
}

QLabel#fileName {

    font-size: 18px;
    font-weight: bold;

    color: white;
}

QLabel#bankLabel {

    font-size: 13px;

    color: #CFCFCF;
}

QLabel#statusLabel {

    font-size: 13px;

    color: #22C55E;
}

/* =========================================================
   METRIC CARD
   ========================================================= */

QWidget#metricCard {

    background-color: #2A2A2A;

    border: 1px solid #404040;
    border-radius: 10px;
}

QLabel#metricTitle {

    background: transparent;

    color: #CFCFCF;

    font-size: 13px;
}

QLabel#metricValue {

    background: transparent;

    color: white;

    font-size: 28px;

    font-weight: bold;
}

/* =========================================================
   LOG PANEL
   ========================================================= */

QWidget#logPanel {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 10px;
}

QTextEdit#logText {

    background-color: transparent;

    border: none;

    color: #CFCFCF;

    font-family: Consolas;
    font-size: 13px;

    selection-background-color: #2563EB;
}

QScrollBar:vertical {

    background: transparent;

    width: 10px;

    margin: 0px;
}

QScrollBar::handle:vertical {

    background: #505050;

    border-radius: 5px;

    min-height: 25px;
}

QScrollBar::handle:vertical:hover {

    background: #707070;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {

    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {

    background: transparent;
}


/* =========================================================
   ACTION BAR
   ========================================================= */

QWidget#actionBar {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 10px;
}
/* =========================================================
   TABLES
   ========================================================= */

QTableWidget {

    background-color: #2A2A2A;

    border: 1px solid #404040;

    gridline-color: #404040;

    color: white;

    selection-background-color: #2563EB;

    selection-color: white;

    alternate-background-color: #323232;

    font-size: 13px;

}

QHeaderView::section {

    background-color: #252525;

    color: white;

    border: none;

    border-bottom: 1px solid #404040;

    padding: 8px;

    font-weight: bold;

}

QTableCornerButton::section {

    background-color: #252525;

    border: none;

}

QTableWidget::item {

    padding: 6px;

}

QTableWidget::item:selected {

    background-color: #2563EB;

    color: white;

}

/* =========================================================
   HISTORY TABLE
   ========================================================= */

QTableWidget#historyTable {

    border-radius: 10px;

}

/* =========================================================
   REVIEW TABLE
   ========================================================= */

QTableWidget#reviewTable {

    border-radius: 10px;

}

/* =========================================================
   SIDEBAR
   ========================================================= */

QWidget#sidebar {

    background-image: url(C:/Users/Juan/Desktop/ASIENTO/app/resources/icons/background.png);

    background-repeat: no-repeat;
    background-position: center;

    border-right: 1px solid #303030;
}


/* =========================================================
   SIDEBAR BUTTONS
   ========================================================= */

QPushButton#sidebarButton {

    background: transparent;

    border: none;

    border-left: 3px solid transparent;

    border-radius: 8px;

    color: #D8D8D8;

    text-align: left;

    padding-top: 10px;
    padding-bottom: 10px;

    font-size: 14px;

    font-weight: 700;

}

/* =========================================================
   SIDEBAR BRAND
   ========================================================= */

QLabel#sidebarTitle {

    font-size: 30px;
    font-weight: 800;
    color: white;
    letter-spacing: 2px;

    margin: 0px;
    padding: 0px;
}

QLabel#sidebarSubtitle {

    font-size: 12px;
    font-weight: 500;
    color: #8F8F8F;

    margin: 0px;
    margin-top: -4px;
    padding: 0px;
}

QFrame#sidebarSeparator {

    background-color: #343434;

    max-height: 1px;

    min-height: 1px;

    border: none;

}

QLabel#sidebarVersion {

    color: #6E6E6E;

    font-size: 11px;

    font-weight: 500;

    padding-bottom: 6px;

}

/* =========================================================
   MAIN CONTENT
   ========================================================= */


/* =========================================================
   EXPORT VIEW
   ========================================================= */

QWidget#exportView {
    background-color: #1E1E1E;
}

/* ---------------------------------------------------------
   HEADER
   --------------------------------------------------------- */

QLabel#exportTitle {
    background: transparent;

    color: #FFFFFF;

    font-size: 26px;
    font-weight: 700;
}

QLabel#exportSubtitle {
    background: transparent;

    color: #AFAFAF;

    font-size: 13px;
}

/* ---------------------------------------------------------
   EXPORT CARD
   --------------------------------------------------------- */

QWidget#exportCard {
    background-color: #2A2A2A;

    border: 1px solid #404040;

    border-radius: 12px;
}

/* ---------------------------------------------------------
   FIELD LABELS
   --------------------------------------------------------- */

QLabel#exportFieldLabel {
    background: transparent;

    color: #CFCFCF;

    font-size: 13px;
    font-weight: 600;
}

/* ---------------------------------------------------------
   COMBO BOX
   --------------------------------------------------------- */

QComboBox#exportCombo {
    background-color: #242424;

    color: #FFFFFF;

    border: 1px solid #454545;

    border-radius: 7px;

    padding: 8px 12px;

    min-height: 34px;
}

QComboBox#exportCombo:hover {
    border: 1px solid #5A5A5A;
}

QComboBox#exportCombo:focus {
    border: 1px solid #2563EB;
}

QComboBox#exportCombo QAbstractItemView {
    background-color: #2A2A2A;

    color: #FFFFFF;

    border: 1px solid #404040;

    selection-background-color: #2563EB;

    selection-color: #FFFFFF;
}

/* ---------------------------------------------------------
   FILE NAME
   --------------------------------------------------------- */

QLineEdit#exportFileName {
    background-color: #242424;

    color: #FFFFFF;

    border: 1px solid #454545;

    border-radius: 7px;

    padding: 8px 12px;

    min-height: 34px;
}

QLineEdit#exportFileName:hover {
    border: 1px solid #5A5A5A;
}

QLineEdit#exportFileName:focus {
    border: 1px solid #2563EB;
}

/* ---------------------------------------------------------
   EDIT TEMPLATE
   --------------------------------------------------------- */

QPushButton#editTemplateButton {
    background-color: #404040;

    color: #FFFFFF;

    border-radius: 7px;

    padding: 8px 14px;

    min-height: 32px;
}

QPushButton#editTemplateButton:hover {
    background-color: #4A4A4A;
}

QPushButton#editTemplateButton:pressed {
    background-color: #353535;
}

/* ---------------------------------------------------------
   EXPORT
   --------------------------------------------------------- */

QPushButton#exportButton {
    background-color: #22C55E;

    color: #FFFFFF;
}

QPushButton#exportButton:hover {
    background-color: #16A34A;
}

QPushButton#exportButton:pressed {
    background-color: #15803D;
}

/* ---------------------------------------------------------
   CANCEL
   --------------------------------------------------------- */

QPushButton#cancelExportButton {
    background-color: #404040;

    color: #D8D8D8;
}

QPushButton#cancelExportButton:hover {
    background-color: #4A4A4A;
}

QPushButton#cancelExportButton:pressed {
    background-color: #353535;
}

/* =========================================================
   TEMPLATE EDITOR
   ========================================================= */

#templateEditorView {
    background: #f7f8fa;
}

#templateEditorTitle {
    font-size: 25px;
    font-weight: 600;
    color: #20242a;
}

#templateEditorSubtitle {
    font-size: 13px;
    color: #7a8088;
}

#templateEditorCard {
    background: white;
    border: 1px solid #e3e6ea;
    border-radius: 10px;
}

#templateFieldLabel {
    font-size: 12px;
    font-weight: 600;
    color: #555b63;
}

#templateNameInput {
    min-height: 38px;
    padding: 0 10px;
    border: 1px solid #d9dde2;
    border-radius: 6px;
    background: white;
    color: #20242a;
}

#templateNameInput:focus {
    border: 1px solid #8c96a3;
}

#templateColumnsList {
    min-height: 220px;
    border: 1px solid #dfe3e8;
    border-radius: 7px;
    background: #fafbfc;
    padding: 4px;
}

#templateColumnsList::item {
    min-height: 36px;
    padding: 0 10px;
    border-radius: 5px;
    color: #30353b;
}

#templateColumnsList::item:selected {
    background: #e9edf2;
    color: #20242a;
}

#addTemplateColumnButton {
    min-height: 34px;
    padding: 0 12px;
    border: 1px dashed #c8cdd3;
    border-radius: 6px;
    background: transparent;
    color: #626972;
}

#addTemplateColumnButton:hover {
    background: #f3f5f7;
    border-color: #aeb5bd;
}

#cancelTemplateButton {
    min-height: 38px;
    padding: 0 18px;
    border: 1px solid #d5d9de;
    border-radius: 6px;
    background: white;
    color: #555b63;
}

#cancelTemplateButton:hover {
    background: #f3f4f6;
}

#saveTemplateButton {
    min-height: 38px;
    padding: 0 20px;
    border: none;
    border-radius: 6px;
    background: #30363d;
    color: white;
    font-weight: 600;
}

#saveTemplateButton:hover {
    background: #24292f;
}